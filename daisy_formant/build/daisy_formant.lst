 278:daisy_formant.cpp ****         // ── Envelope follower / consonant onset ───────────────
 279:daisy_formant.cpp ****         // Mono abs value feeds two followers with different release times.
 280:daisy_formant.cpp ****         // Transient = fast − slow: non-zero only on pick attacks.
 281:daisy_formant.cpp ****         float envIn    = 0.5f * (fabsf(drvL) + fabsf(drvR));
 282:daisy_formant.cpp ****         float fast     = envFast.Process(envIn);
 283:daisy_formant.cpp ****         float slow     = envSlow.Process(envIn);
 284:daisy_formant.cpp ****         float transient = (fast > slow) ? (fast - slow) : 0.0f;
 285:daisy_formant.cpp ****         if(transient > blockTransient) blockTransient = transient;
 286:daisy_formant.cpp **** 
 287:daisy_formant.cpp ****         // Trigger onset on sharp transient; don't re-trigger while decaying.
