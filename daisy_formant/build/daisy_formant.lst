   1:daisy_formant.cpp **** // daisy_formant.cpp
   2:daisy_formant.cpp **** // -----------------
   3:daisy_formant.cpp **** // Dual-effect pedal for Daisy Pod:
   4:daisy_formant.cpp **** //
   5:daisy_formant.cpp **** //   KNOB 1 (left)  — Wah filter
   6:daisy_formant.cpp **** //                    Sweeps a bandpass filter from 350 Hz (heel) to 2500 Hz (toe).
   7:daisy_formant.cpp **** //
   8:daisy_formant.cpp **** //   KNOB 2 (right) — Vowel / talk-box filter
   9:daisy_formant.cpp **** //                    Sweeps through OO → OH → AH → AE → EE by turning clockwise.
  10:daisy_formant.cpp **** //                    Uses a 5-resonator all-pole vocal tract cascade — the same
  11:daisy_formant.cpp **** //                    physical model that makes a talk box work.
ARM GAS  /var/folders/1b/1q9m9h2n5vq5b3524jm_htnw0000gn/T//cckcbKg4.s 			page 22


  12:daisy_formant.cpp **** //
  13:daisy_formant.cpp **** // Signal chain (mono, applied to both output channels):
  14:daisy_formant.cpp **** //
  15:daisy_formant.cpp **** //   input
  16:daisy_formant.cpp **** //     → hard-clip saturator    (drive = 10, approaches square wave)
  17:daisy_formant.cpp **** //     → high-shelf pre-emphasis (+6 dB above 1 kHz)
  18:daisy_formant.cpp **** //     → wah BPF                (knob1, Q = 4, wet = 0.8)
  19:daisy_formant.cpp **** //     → F1→F2→F3→F4→F5         (knob2, cascade of 5 all-pole resonators)
  20:daisy_formant.cpp **** //     → output
  21:daisy_formant.cpp **** //
  22:daisy_formant.cpp **** // Build: same Makefile pattern as HW4.
  23:daisy_formant.cpp **** // Flash: make && make program-dfu
  24:daisy_formant.cpp **** //
  25:daisy_formant.cpp **** // References: HW4_Q1.cpp (delay/LFO pattern), HW4_Q4/HW4_Q3.cpp (BiquadLocal struct)
  26:daisy_formant.cpp **** 
  27:daisy_formant.cpp **** #include "daisysp.h"
  28:daisy_formant.cpp **** #include "daisy_pod.h"
  29:daisy_formant.cpp **** #include <cmath>
  30:daisy_formant.cpp **** 
  31:daisy_formant.cpp **** using namespace daisysp;
  32:daisy_formant.cpp **** using namespace daisy;
  33:daisy_formant.cpp **** 
  34:daisy_formant.cpp **** static DaisyPod pod;
  35:daisy_formant.cpp **** 
  36:daisy_formant.cpp **** // ---------------------------------------------------------------------------
  37:daisy_formant.cpp **** // Constants
  38:daisy_formant.cpp **** // ---------------------------------------------------------------------------
  39:daisy_formant.cpp **** 
  40:daisy_formant.cpp **** static const float DRIVE          = 10.0f;   // hard-clip drive (square-wave source)
  41:daisy_formant.cpp **** static const float PRE_EMPHASIS_DB = 6.0f;   // high-shelf gain above 1 kHz
  42:daisy_formant.cpp **** static const float WAH_Q           = 4.0f;   // wah bandpass Q
  43:daisy_formant.cpp **** static const float WAH_F_MIN       = 350.0f; // knob1 = 0 → 350 Hz
  44:daisy_formant.cpp **** static const float WAH_F_MAX       = 2500.0f;// knob1 = 1 → 2500 Hz
  45:daisy_formant.cpp **** static const float WAH_WET         = 0.8f;   // wah dry/wet blend
  46:daisy_formant.cpp **** static const float FORMANT_WET     = 0.95f;  // formant dry/wet blend
  47:daisy_formant.cpp **** static const int   N_FORMANTS      = 5;
  48:daisy_formant.cpp **** 
  49:daisy_formant.cpp **** // Vowel formant table: 5 vowels × 5 formants (F1–F5) in Hz.
  50:daisy_formant.cpp **** // From Hillenbrand et al. (1995), American English male averages.
  51:daisy_formant.cpp **** //                      F1      F2      F3      F4      F5
  52:daisy_formant.cpp **** static const float VOWEL_F[5][5] = {
  53:daisy_formant.cpp ****     {  300.0f,   870.0f, 2240.0f, 3180.0f, 3800.0f },   // OO  "boot"
  54:daisy_formant.cpp ****     {  500.0f,  1000.0f, 2500.0f, 3300.0f, 4000.0f },   // OH  "go"
  55:daisy_formant.cpp ****     {  800.0f,  1200.0f, 2500.0f, 3300.0f, 4000.0f },   // AH  "father"
  56:daisy_formant.cpp ****     {  600.0f,  1900.0f, 2600.0f, 3300.0f, 4200.0f },   // AE  "cat"
  57:daisy_formant.cpp ****     {  300.0f,  2300.0f, 3000.0f, 3600.0f, 4300.0f },   // EE  "feet"
  58:daisy_formant.cpp **** };
  59:daisy_formant.cpp **** 
  60:daisy_formant.cpp **** // Formant bandwidths (Hz) — real vocal tract values, NOT Q-derived.
  61:daisy_formant.cpp **** static const float FORMANT_BW[5] = { 60.0f, 90.0f, 150.0f, 200.0f, 250.0f };
  62:daisy_formant.cpp **** 
  63:daisy_formant.cpp **** // ---------------------------------------------------------------------------
  64:daisy_formant.cpp **** // Biquad filter — direct-form II transposed
  65:daisy_formant.cpp **** // Identical to HW4_Q4/HW4_Q3.cpp BiquadLocal, changed to float for speed.
  66:daisy_formant.cpp **** // ---------------------------------------------------------------------------
  67:daisy_formant.cpp **** 
  68:daisy_formant.cpp **** struct Bq {
ARM GAS  /var/folders/1b/1q9m9h2n5vq5b3524jm_htnw0000gn/T//cckcbKg4.s 			page 23


  69:daisy_formant.cpp ****     float b0, b1, b2, a1, a2, z1, z2;
  70:daisy_formant.cpp **** 
  71:daisy_formant.cpp ****     Bq() {
  72:daisy_formant.cpp ****         b0 = 1.0f; b1 = 0.0f; b2 = 0.0f;
  73:daisy_formant.cpp ****         a1 = 0.0f; a2 = 0.0f;
  74:daisy_formant.cpp ****         Reset();
  75:daisy_formant.cpp ****     }
  76:daisy_formant.cpp **** 
  77:daisy_formant.cpp ****     void SetCoefs(float* c) {
  78:daisy_formant.cpp ****         // c = [b0, b1, b2, a1, a2]
  79:daisy_formant.cpp ****         b0 = c[0]; b1 = c[1]; b2 = c[2];
  80:daisy_formant.cpp ****         a1 = c[3]; a2 = c[4];
  81:daisy_formant.cpp ****     }
  82:daisy_formant.cpp **** 
  83:daisy_formant.cpp ****     void Reset() { z1 = 0.0f; z2 = 0.0f; }
  84:daisy_formant.cpp **** 
  85:daisy_formant.cpp ****     float Process(float x) {
  86:daisy_formant.cpp ****         float y = b0 * x + z1;
  87:daisy_formant.cpp ****         z1 = b1 * x - a1 * y + z2;
  88:daisy_formant.cpp ****         z2 = b2 * x - a2 * y;
  89:daisy_formant.cpp ****         return y;
  90:daisy_formant.cpp ****     }
  91:daisy_formant.cpp **** };
  92:daisy_formant.cpp **** 
  93:daisy_formant.cpp **** // ---------------------------------------------------------------------------
  94:daisy_formant.cpp **** // Filter bank (stereo pairs)
  95:daisy_formant.cpp **** // ---------------------------------------------------------------------------
  96:daisy_formant.cpp **** 
