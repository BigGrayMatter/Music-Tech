 193:daisy_formant.cpp **** 
 194:daisy_formant.cpp **** // Map pos [0, 1] to 5 formant frequencies by linear interpolation
 195:daisy_formant.cpp **** // along the OO → OH → AH → AE → EE trajectory.
 196:daisy_formant.cpp **** void InterpFormants(float pos, float* freqs_out)
 197:daisy_formant.cpp **** {
