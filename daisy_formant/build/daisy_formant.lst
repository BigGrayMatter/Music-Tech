 112:daisy_formant.cpp ****     float Process(float x) {
 113:daisy_formant.cpp ****         float level = fabsf(x);
 114:daisy_formant.cpp ****         float coeff = (level > value) ? attackCoeff : releaseCoeff;
 115:daisy_formant.cpp ****         value = coeff * value + (1.0f - coeff) * level;
 116:daisy_formant.cpp ****         return value;
 117:daisy_formant.cpp ****     }
 118:daisy_formant.cpp **** };
